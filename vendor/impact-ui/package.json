{
  "name": "impact-ui",
  "version": "5.0.2",
  "description": "Impact Analytics UI library",
  "type": "module",
  "main": "./dist/components/index.js",
  "module": "./dist/components/index.js",
  "types": "./dist/components/index.d.ts",
  "sideEffects": [
    "./dist/styles/style.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./styles.css": "./dist/styles/style.css",
    "./styles": "./dist/styles/style.css",
    "./package.json": "./package.json",
    "./eslint-plugin": {
      "import": "./eslint-plugin/index.js"
    },
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    },
    "./common/*": {
      "types": "./dist/components/common/*/index.d.ts",
      "import": "./dist/components/common/*/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./utils/assetBase": {
      "types": "./dist/utils/assetBase.d.ts",
      "import": "./dist/utils/assetBase.js"
    }
  },
  "bin": {
    "impact-ui-migrate": "bin/migrate.js"
  },
  "files": [
    "dist",
    "bin",
    "codemods",
    "eslint-plugin",
    "README.md",
    "MIGRATION_GUIDE.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib",
    "build:lib": "node ./scripts/clean-dist.mjs && tsc --noEmit && SOURCE_MAP=0 vite build && SOURCE_MAP=0 vite build --config vite.styles.config.ts && node ./scripts/generate-mcp-registry.mjs",
    "build:lib:debug": "node ./scripts/clean-dist.mjs && tsc && NO_MINIFY=1 SOURCE_MAP=1 vite build && node ./scripts/generate-mcp-registry.mjs",
    "optimize:images": "node ./scripts/optimize-images.mjs",
    "optimize:images:dry": "node ./scripts/optimize-images.mjs --dry-run",
    "optimize:images:staged": "node ./scripts/optimize-images.mjs --verbose",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "test:storybook": "vitest --project=storybook",
    "test:storybook:run": "vitest run --project=storybook",
    "test": "vitest --project=unit",
    "test:run": "vitest run --project=unit",
    "test:root-attrs": "vitest run --project=unit src/components/__tests__/componentRootAttributes.test.tsx",
    "test:automation-ids": "vitest run --project=unit -t \"forwards id and data-testid\"",
    "test:ui": "vitest --project=unit --ui",
    "test:coverage": "vitest run --project=unit --coverage",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --report-unused-disable-directives",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "lint:a11y": "eslint . --ext .tsx",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,scss,md}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,scss,md}\"",
    "type-check": "tsc --noEmit",
    "format:fix": "npm run format -- --write && npm run lint:fix",
    "validate": "npm run lint && npm run format:check && npm run type-check && npm run test:coverage",
    "pre-push": "npm run type-check && npm run lint:errors && npm run format && npm run test:coverage",
    "lint:errors": "eslint . --ext .js,.jsx,.ts,.tsx --quiet",
    "docs": "cd docs && npm start",
    "docs:build": "npm run docs:api && cd docs && npm run build",
    "docs:api": "typedoc --options typedoc.json",
    "docs:serve": "cd docs && npm run serve",
    "docs:deploy": "npm run docs:build && cd docs && npm run deploy",
    "migrate:image-paths": "node ./bin/migrate-image-paths.cjs ./src",
    "migrate:image-paths:dry": "node ./bin/migrate-image-paths.cjs ./src --dry"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "./node_modules/.bin/prettier --write"
    ],
    "src/**/*.{json,scss,md}": [
      "./node_modules/.bin/prettier --write"
    ],
    "src/assets/**/*.{svg,png,jpg,jpeg}": [
      "node ./scripts/optimize-images.mjs --verbose",
      "sh -c 'git add -A src/assets/webp || true'"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "devDependencies": {
    "@axe-core/react": "^4.8.4",
    "@chromatic-com/storybook": "^5.0.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@impactsmartsuite/impact-icons": "^0.1.4",
    "@mui/base": "^5.0.0-alpha.82",
