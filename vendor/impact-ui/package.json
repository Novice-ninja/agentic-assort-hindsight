    "react-dates": "^21.8.0",
    "react-dom": "^17.0.0",
    "react-syntax-highlighter": "^15.5.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.72.0",
    "sharp": "^0.34.5",
    "storybook": "10.2.15",
    "svgo": "^4.0.1",
    "terser": "^5.46.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vite-plugin-css-injected-by-js": "^4.0.1",
    "vite-plugin-dts": "^3.7.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.0.18",
    "vitest-axe": "^0.1.0"
  },
  "peerDependencies": {
    "@emotion/react": ">=11.14.0",
    "@emotion/styled": ">=11.14.0",
    "@mui/material": ">=5.0.0",
