    "@mui/private-theming": "^5.8.0",
    "@mui/styled-engine": "^5.8.0",
    "@mui/styled-engine-sc": "^5.8.0",
    "@mui/styles": "^5.8.0",
    "@mui/system": "^5.8.1",
    "@mui/types": "^7.1.3",
    "@mui/x-date-pickers": "^5.0.0-alpha.4",
    "@storybook/addon-a11y": "10.2.15",
    "@storybook/addon-docs": "10.2.15",
    "@storybook/addon-vitest": "10.2.15",
    "@storybook/react-vite": "10.2.15",
    "@testing-library/jest-dom": "^6.2.0",
    "@testing-library/react": "^12.1.2",
    "@testing-library/user-event": "^14.6.1",
    "@tiptap/extension-highlight": "^2.26.1",
    "@tiptap/extension-image": "^2.26.1",
    "@tiptap/extension-link": "^2.26.1",
    "@tiptap/extension-mention": "^2.26.1",
    "@tiptap/extension-placeholder": "^2.26.1",
    "@tiptap/extension-strike": "^2.26.1",
    "@tiptap/react": "^2.26.1",
    "@tiptap/starter-kit": "^2.26.1",
    "@tiptap/suggestion": "^2.26.1",
    "@types/node": "^20.11.0",
    "@types/react": "^17.0.80",
    "@types/react-dom": "^17.0.25",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-istanbul": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "ag-grid-community": "^36.2.0",
    "ag-grid-enterprise": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "cssnano": "^7.1.3",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-storybook": "10.2.15",
    "highcharts": "^12.4.0",
    "highcharts-react-official": "^3.2.3",
    "husky": "^8.0.3",
    "jscodeshift": "^0.15.2",
    "jsdom": "^28.1.0",
    "lint-staged": "^15.2.0",
    "moment": "^2.29.4",
    "playwright": "^1.58.2",
    "postcss": "^8.5.8",
    "prettier": "^3.2.4",
